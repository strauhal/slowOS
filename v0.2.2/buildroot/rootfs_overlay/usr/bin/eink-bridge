LOG_PATH = '/var/log/eink-bridge.log'
STATUS_PATH = '/run/eink-bridge.status'


def _write_status(payload):
    """Atomic JSON for operators: cat /run/eink-bridge.status (no log parsing)."""
    try:
        tmp = STATUS_PATH + '.tmp'
        with open(tmp, 'w', encoding='utf-8') as f:
            json.dump(payload, f, indent=None, separators=(',', ':'))
        os.replace(tmp, STATUS_PATH)
    except OSError:
        pass


def _configure_logging():
    root = logging.getLogger()
    root.handlers.clear()
    root.setLevel(logging.INFO)
    # Line-buffered text stream so diagnostics appear promptly under tail -f
    stream = open(LOG_PATH, 'a', encoding='utf-8', buffering=1)
    fh = logging.StreamHandler(stream)
    fh.setFormatter(logging.Formatter('[eink-bridge] %(levelname)s: %(message)s'))
    root.addHandler(fh)


log = logging.getLogger('eink-bridge')

# --- Configuration ---
# Waveshare 13.3" e-Paper HAT (K): 960×680 per vendor wiki — matches epd13in3k.EPD_WIDTH/HEIGHT.
DISPLAY_WIDTH = 960
DISPLAY_HEIGHT = 680
XVFB_DISPLAY = ':99'
# Default: more partial updates before a slow full refresh (ghosting tradeoff).
FULL_REFRESH_EVERY_DEFAULT = 24
DIAG_INTERVAL_SEC = 15.0  # Periodic INFO line for field tests (/var/log/eink-bridge.log)


def _rect_axis_gap_exclusive(a, b):
    """Min gap between outer edges along each axis [l,r) tuples; returns (gx, gy)."""
    al, at, ar, ab = a
    bl, bt, br, bb = b
    if ar <= bl:
        gx = bl - ar
    elif br <= al:
        gx = al - br
    else:
        gx = 0
    if ab <= bt:
        gy = bt - ab
    elif bb <= at:
        gy = at - bb
    else:
        gy = 0
    return gx, gy


def _rect_union_exclusive(a, b):
    return (
        min(a[0], b[0]),
        min(a[1], b[1]),
        max(a[2], b[2]),
        max(a[3], b[3]),
    )


def _rects_overlap_excl(a, b):
    """True if closed axis-aligned rects [l,t,r,b) intersect with positive area."""
    gx, gy = _rect_axis_gap_exclusive(a, b)
    return gx == 0 and gy == 0


def fit_capture_to_panel(img_l, fit_mode):
    """
    Map root capture → panel size.
    When X root already matches the panel (960×680), copy 1:1 — no resample (panel-first).
    cover: scale to fill 960×680, center-crop.
    letterbox: uniform scale to fit inside panel, pad with white (fallback if X is not panel size).
    """
    w, h = img_l.size
    tw, th = DISPLAY_WIDTH, DISPLAY_HEIGHT
    if w == tw and h == th:
        return img_l, (w, h)
    mode = (fit_mode or 'letterbox').strip().lower()
    if mode == 'letterbox':
        scale = min(tw / float(w), th / float(h))
        nw = max(1, int(round(w * scale)))
        nh = max(1, int(round(h * scale)))
        resized = img_l.resize((nw, nh), Image.LANCZOS)
        canvas = Image.new('L', (tw, th), color=255)
        ox = (tw - nw) // 2
        oy = (th - nh) // 2
        canvas.paste(resized, (ox, oy))
        return canvas, (w, h)
    # cover: fill panel, crop edges (opt-in via SLOWOS_EINK_FIT=cover)
    scale = max(tw / float(w), th / float(h))
    nw = max(1, int(round(w * scale)))
    nh = max(1, int(round(h * scale)))
    resized = img_l.resize((nw, nh), Image.LANCZOS)
    ox = (nw - tw) // 2
    oy = (nh - th) // 2
    out = resized.crop((ox, oy, ox + tw, oy + th))
    return out, (w, h)


class EinkBridge:
    def __init__(self, display=None, fps=6, use_xvfb=True):
        self.display = display or XVFB_DISPLAY
        self.poll_interval = 1.0 / fps
        self.use_xvfb = use_xvfb
        self.xvfb_proc = None
        self.epd = None
        # letterbox: full root scaled into panel (best when shell fills HDMI). cover: fill+crop
        # center — if the GUI lives in a corner of the capture, cover shows mostly black/wrong crop.
        self._fit_mode = os.environ.get('SLOWOS_EINK_FIT', 'letterbox').strip().lower()
        if self._fit_mode not in ('cover', 'letterbox'):
            log.warning(f"SLOWOS_EINK_FIT={self._fit_mode!r} invalid; using letterbox")
            self._fit_mode = 'letterbox'
        # 0 = push on every captured pixel change (matches pre-coalesce behavior). Set >0 to cap rate.
        self._min_push_interval = float(os.environ.get('SLOWOS_EINK_MIN_PUSH_INTERVAL_SEC', '0'))
        self._full_refresh_every = int(os.environ.get('SLOWOS_EINK_FULL_REFRESH_EVERY', str(FULL_REFRESH_EVERY_DEFAULT)))
        if self._full_refresh_every < 1:
            self._full_refresh_every = FULL_REFRESH_EVERY_DEFAULT
        self._periodic_full_mono_enabled = os.environ.get('SLOWOS_EINK_PERIODIC_FULL_MONO', '0').strip().lower() in (
            '1', 'true', 'yes', 'on',
        )
        # When min_push_interval>0, skip coalescing for this many seconds after start so boot/HMI
        # paints reach e-ink before RepaintController goes idle. 0 = disabled.
        self._push_boot_grace_sec = float(
            os.environ.get(
                'SLOWOS_EINK_PUSH_BOOT_GRACE_SEC',
                '90' if self._min_push_interval > 0 else '0',
            )
        )
        # Dirty-rectangle partials: small SPI/waveform region when few pixels change (e.g. pointer).
        self._dirty_rect = os.environ.get('SLOWOS_EINK_DIRTY_RECT', '1').strip() in ('1', 'true', 'yes', 'on')
        self._dirty_margin = int(os.environ.get('SLOWOS_EINK_DIRTY_MARGIN', '12'))
        self._dirty_thresh = int(os.environ.get('SLOWOS_EINK_DIRTY_THRESHOLD', '14'))
        self._dirty_area_max = float(os.environ.get('SLOWOS_EINK_DIRTY_AREA_MAX', '0.42'))
        self._dirty_max_px = int(self._dirty_area_max * DISPLAY_WIDTH * DISPLAY_HEIGHT)
        self._cursor_overlay = os.environ.get('SLOWOS_EINK_CURSOR_OVERLAY', '1').strip() in ('1', 'true', 'yes', 'on')
        # Multi-region tiling: deterministic dirty regions vs single PIL getbbox().
        self._dirty_tile_px = max(8, int(os.environ.get('SLOWOS_EINK_DIRTY_TILE', '32')))
        self._dirty_max_regions = max(1, int(os.environ.get('SLOWOS_EINK_DIRTY_MAX_REGIONS', '6')))
        self._dirty_merge_gap_px = int(os.environ.get('SLOWOS_EINK_DIRTY_MERGE_GAP_PX', '48'))
        esc_pulse = max(6, int(os.environ.get('SLOWOS_EINK_ESC_PULSE_PARTIALS', '14')))
        self._esc_pulse_partials_limit = esc_pulse
        busy_warn = float(os.environ.get('SLOWOS_EINK_BUSY_WARN_MS', '0'))  # 0 = disable (full refresh can exceed 12s)

        self._last_pushed_hash = None
        self._pending_frame = None
        self._pending_hash = None
        self._last_push_mono = 0.0

        self.partial_count = 0
        self.running = True
        self.initialized = False
        self._stat_capture_ok = 0
        self._stat_capture_fail = 0
        self._stat_push_ok = 0
        self._stat_push_fail = 0
        self._last_diag_wall = 0.0
        self._last_src_size = (0, 0)
        self._last_error = ''
        self._last_push_l = None  # last pushed grayscale (post-overlay), for diff
        self._stat_dirty_partial = 0
        self._stat_dirty_fullrect = 0
        # Cache honesty + instrumentation ( sprint hardening ).
        self._cache_confidence = 'ok'
        self._degraded_reason = ''
        self._busy_warn_ms_thresh = busy_warn
        self._partial_pulse_key = None
        self._partial_pulse_seq = 0
        self._force_full_refresh_next = False
        self._force_full_rect_next = False
        self._degraded_wave_count = 0
        esc_to_mono = max(3, int(os.environ.get('SLOWOS_EINK_DEGRADED_FULL_MONO_CYCLES', '3')))
        self._degraded_wave_to_mono_cycles = esc_to_mono
        self._last_push_mode = 'none'
        self._last_dirty_rect_count = 0
        self._last_dirty_tile_count = 0
        self._last_dirty_area_px_raw = 0
        self._last_merged_regions_area_px = 0
        self._last_push_ms = None
        self._last_busy_approx_ms = None

        # Phase 2.5: pointer / reconcile / escalation (see module docstring).
        self._phase25 = os.environ.get('SLOWOS_EINK_PHASE25', '1').strip().lower() in (
            '1', 'true', 'yes', 'on',
        )
        self._pointer_hz = max(0.25, float(os.environ.get('SLOWOS_EINK_POINTER_HZ', '6')))
        self._reconcile_sec = max(0.5, float(os.environ.get('SLOWOS_EINK_RECONCILE_SEC', '3')))
        self._esc_soft_sec = max(0.1, float(os.environ.get('SLOWOS_EINK_ESCAL_SOFT_SEC', '3')))
        self._esc_hard_sec = max(self._esc_soft_sec, float(os.environ.get('SLOWOS_EINK_ESCAL_HARD_SEC', '6')))
        self._region_cap = min(8, max(2, int(os.environ.get('SLOWOS_EINK_REGION_CAP', '3'))))
        self._pointer_arena = max(32, int(os.environ.get('SLOWOS_EINK_POINTER_ARENA', '96')))
        self._restart_grace_sec = max(0.5, float(os.environ.get('SLOWOS_EINK_RESTART_GRACE_SEC', '2')))
        self._last_reconcile_mono = 0.0
        self._last_pointer_push_mono = 0.0
        self._last_mouse_xy = None
        self._first_push_fail_mono = None
        self._escalation_deadline_mono = None
        self._last_reconcile_wall = 0.0
        self._post_deadline_fail_streak = 0
        # Phase 2.6 sprint: watchdog, focus hints, trail merge, scheduler observability.
        self._watchdog_max_frames = max(4, int(os.environ.get('SLOWOS_EINK_WATCHDOG_FRAMES', '24')))
        self._watchdog_ink_doubt_frames = max(
            self._watchdog_max_frames + 1,
            int(os.environ.get('SLOWOS_EINK_WATCHDOG_INK_DOUBT_FRAMES', str(self._watchdog_max_frames * 2))),
        )
        self._captures_since_push = 0
        self._hash_same_streak = 0
        self._audit_trigger_count = 0
        self._push_reason_last = 'none'
        self._pointer_moved_last = False
        self._caret_path_used = 'none'
        self._region_merge_mode = 'dual'
        self._cursor_region_count = 0
        self._focus_hints = os.environ.get('SLOWOS_EINK_FOCUS_HINTS', '1').strip().lower() in (
            '1', 'true', 'yes', 'on',
        )
        self._focus_poll_hz = max(0.25, float(os.environ.get('SLOWOS_EINK_FOCUS_POLL_HZ', '4')))
        self._last_focus_poll_mono = 0.0
        self._focus_win_id = None
        self._focus_win_name = ''
        self._focus_rect = None
        self._focus_dirty_one_shot = False
        self._pointer_trail = os.environ.get('SLOWOS_EINK_POINTER_TRAIL', '1').strip().lower() in (
            '1', 'true', 'yes', 'on',
        )
        self._pointer_prev_xy = None
        # Last _dual_track_regions() telemetry (Phase 2.6 overlap union).
        self._dual_track_raw_clusters = 0
        self._dual_track_output_rects = 0
        self._dual_track_overlap_unions = 0
        self._dual_track_appended_rects = 0
        self._dual_track_region_policy = 'union_on_overlap'
        # Overlap audit (last push precompute + cumulative).
        self._dual_track_overlap_detect_last = 0
        self._dual_track_union_area_delta_last = 0
        self._dual_track_cap_hit_last = False
        self._dual_track_overlap_detect_total = 0
        self._dual_track_union_area_delta_total = 0
        self._dual_track_union_count_total = 0
        # Producer/consumer (Phase 2.5): latest-frame-wins depth 1; producer never touches SPI/belief.
        self._slot_lock = threading.Lock()
        self._latest_frame_ref = None
        self._latest_capture_wall_ts = 0.0
        self._latest_capture_mono = 0.0
        self._latest_capture_seq = 0
        self._producer_overwrites = 0
        self._producer_thread = None
        self._push_seq = 0
        self._consumer_idle_sleep_ms_last = 0.0
        # Hot-path instrumentation (consumer).
        self._last_loop_ms = None
        self._last_capture_ms = None
        self._last_capture_to_push_ms = None
        self._last_capture_to_decide_ms = None
        self._latest_frame_age_ms = None
        self._captures_per_wall_s = 0.0
        self._pushes_per_wall_s = 0.0
        self._last_rate_tick_wall = None
        self._last_rate_cap_ok = 0
        self._last_rate_push_ok = 0
        self._last_rate_capture_seq = 0
        self._last_no_push_reason = 'boot'
        self._last_push_reason = 'none'
        self._hash_changed_last = False
        self._reconcile_diff_empty_last = False
        self._focus_hint_used_last = False
        self._last_regions_premerge = 0
        self._last_regions_postmerge = 0
        self._last_overlap_unions = 0
        self._last_dirty_area_px_effective = 0
        self._bridge_wall_start = time.time()
        self._last_capture_profile_ms = {}
        self._pointer_overlay_interval = max(0.05, 1.0 / max(self._pointer_hz, 0.25))
        self._pointer_overlay_poll_mono = 0.0
        self._pointer_overlay_xy_cache = None
        self._status_rate_prev_wall = None
        self._status_rate_prev_cap_seq = 0
        self._status_rate_prev_push_seq = 0
        self._focus_resync_sec = float(os.environ.get('SLOWOS_EINK_FOCUS_RESYNC_SEC', '0'))
        if self._focus_resync_sec < 0:
            self._focus_resync_sec = 0.0
        self._focus_resync_min_captures = max(
            2, int(os.environ.get('SLOWOS_EINK_FOCUS_RESYNC_MIN_CAPTURES', '6'))
        )
        self._last_focus_resync_mono = None
        # Phase 2.5b: typing vs pointer, ghost policy telemetry, belief/hash alignment.
        self._typing_priority_streak = max(
            2, int(os.environ.get('SLOWOS_EINK_TYPING_PRIORITY_STREAK', '6'))
        )
        self._region_debt_partial_hits = 0
        self._debt_partial_hits_cursor = 0

        self._ghost_escalate_events = 0
        self._cursor_erase_draw_passes = 0
        self._cursor_prev_hull_excl = None
        self._last_full_mono_cause = 'none'
        self._last_full_mono_wall_ts = 0.0
        self._full_mono_interval_samples = []
        self._full_mono_by_cause = {}
        self._cursor_ghost_escalate_events = 0
        # Product policy: GUI truth > belief; anti-rollback; typing FIFO (see module doc env lines).
        self._antirollback_hash_fullrect = os.environ.get(
            'SLOWOS_EINK_ANTIROLLBACK_HASH_FULLRECT', '1'
        ).strip().lower() in ('1', 'true', 'yes', 'on')
        self._pending_antirollback_fullrect = False
        self._text_freshness = os.environ.get('SLOWOS_EINK_TEXT_FRESHNESS', '1').strip().lower() in (
            '1', 'true', 'yes', 'on',
        )
        self._text_capture_fifo_enabled = os.environ.get(
            'SLOWOS_EINK_TEXT_CAPTURE_FIFO', '1'
        ).strip().lower() in ('1', 'true', 'yes', 'on')
        self._text_capture_fifo = deque()
        self._text_capture_fifo_drains = 0
        self._text_freshness_active_last = False
        self._reconcile_soft_refresh = False
        self._cursor_bleach_partials = os.environ.get(
            'SLOWOS_EINK_CURSOR_BLEACH_PARTIALS', '1'
        ).strip().lower() in ('1', 'true', 'yes', 'on')
        self._latency_min_samples = max(3, int(os.environ.get('SLOWOS_EINK_LATENCY_MIN_SAMPLES', '10')))
        self._ptr_lat_samples = deque(maxlen=int(os.environ.get('SLOWOS_EINK_LATENCY_SAMPLE_CAP', '512')))
        self._type_lat_samples = deque(maxlen=int(os.environ.get('SLOWOS_EINK_LATENCY_SAMPLE_CAP', '512')))
        self._ptr_motion_armed_mono = None
        self._typing_lat_t0_mono = None

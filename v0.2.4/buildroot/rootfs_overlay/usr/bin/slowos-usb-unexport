#!/bin/sh
# slowos-usb-unexport — Exit USB mass storage gadget mode.
#
# Unloads g_mass_storage, remounts the FAT32 data partition, re-binds
# the user folders onto /root, and runs slowos-autosort on anything
# the host dropped at the top level of the drive.

set -e

DATA_DEV="/dev/mmcblk0p3"
DATA_MNT="/data"
STATE_FILE="/tmp/slowos/usb_state"

mkdir -p /tmp/slowos

# Unload the gadget driver
rmmod g_mass_storage 2>/dev/null || true

# Re-mount the data partition
if ! mountpoint -q "$DATA_MNT"; then
    mount "$DATA_MNT" 2>/dev/null || true
fi

# Defensive: ensure folder structure exists (host may have wiped it)
mkdir -p /data/Books /data/Music /data/Music/MIDI /data/Pictures /data/Documents /data/.slowos/config

# Re-establish bind-mounts so apps see files at /root/Books etc.
mountpoint -q /root/Books      || mount --bind /data/Books      /root/Books
mountpoint -q /root/Music      || mount --bind /data/Music      /root/Music
mountpoint -q /root/Pictures   || mount --bind /data/Pictures   /root/Pictures
mountpoint -q /root/Documents  || mount --bind /data/Documents  /root/Documents
mountpoint -q /root/.config    || mount --bind /data/.slowos/config /root/.config

echo "disconnected" > "$STATE_FILE"

# Any files the host dropped at the root of the drive (instead of
# inside Books/ / Music/ / etc.) get sorted into the right folder now.
# Files already inside the correct folders are left in place.
if [ -d "$DATA_MNT" ]; then
    # Gather top-level files (not directories, not the README or marker)
    loose=0
    for item in "$DATA_MNT"/*; do
        [ -f "$item" ] || continue
        name="$(basename "$item")"
        case "$name" in
            README.txt) continue ;;
            .*) continue ;;
        esac
        loose=$((loose + 1))
    done

    if [ "$loose" -gt 0 ]; then
        slowos-autosort "$DATA_MNT"
    else
        echo "0" > /tmp/slowos/autosort_result
    fi
fi

echo "USB disconnected"

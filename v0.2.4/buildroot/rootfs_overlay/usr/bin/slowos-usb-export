#!/bin/sh
# slowos-usb-export — Enter USB mass storage gadget mode.
#
# Unmounts bind-mounts, unmounts the FAT32 data partition, then exports
# the partition's block device over USB. The host (Mac / Windows / phone)
# sees the slowBook as a drive named SLOWBOOK with the user's real
# Books/, Music/, Pictures/, and Documents/ folders — files dropped by
# the host land directly in the right place.
#
# Prerequisites (Angel's hardware image):
#   - dwc2 device-tree overlay enabled (dtoverlay=dwc2 in config.txt)
#   - g_mass_storage kernel module available (modprobe-able)

set -e

DATA_DEV="/dev/mmcblk0p3"
DATA_MNT="/data"
STATE_FILE="/tmp/slowos/usb_state"

mkdir -p /tmp/slowos

# Unmount the bind-mounts first (otherwise the underlying /data
# partition can't be unmounted)
for bind in /root/Books /root/Music /root/Pictures /root/Documents /root/.config; do
    mountpoint -q "$bind" && umount "$bind" 2>/dev/null || true
done

# Unmount the data partition itself. If this fails, files in the
# partition are still being written to by something — we can't safely
# export.
if mountpoint -q "$DATA_MNT"; then
    sync
    if ! umount "$DATA_MNT"; then
        # Remount binds so the user isn't left with broken dirs
        mount --bind /data/Books     /root/Books     2>/dev/null || true
        mount --bind /data/Music     /root/Music     2>/dev/null || true
        mount --bind /data/Pictures  /root/Pictures  2>/dev/null || true
        mount --bind /data/Documents /root/Documents 2>/dev/null || true
        mount --bind /data/.slowos/config /root/.config 2>/dev/null || true
        echo "error — could not unmount $DATA_MNT (files are in use)" >&2
        echo "error" > "$STATE_FILE"
        exit 1
    fi
fi

# Load the mass-storage gadget exporting the FAT32 partition
modprobe g_mass_storage file="$DATA_DEV" removable=1 stall=0 ro=0 2>/dev/null || {
    # Restore the data partition + binds before bailing out
    mount "$DATA_MNT" 2>/dev/null || true
    mount --bind /data/Books     /root/Books     2>/dev/null || true
    mount --bind /data/Music     /root/Music     2>/dev/null || true
    mount --bind /data/Pictures  /root/Pictures  2>/dev/null || true
    mount --bind /data/Documents /root/Documents 2>/dev/null || true
    mount --bind /data/.slowos/config /root/.config 2>/dev/null || true
    echo "failed to load g_mass_storage — is dwc2 enabled?" >&2
    echo "error" > "$STATE_FILE"
    exit 1
}

echo "connected" > "$STATE_FILE"
echo "USB mass storage active — host can now access slowBook files"
